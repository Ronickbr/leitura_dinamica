# Firebase Client (prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# URL oficial da aplicação em produção
NEXT_PUBLIC_APP_URL=https://seu-dominio-oficial.example

# Pesquisa / governança de dados
# Defina antes da coleta conforme o protocolo aprovado (AAAA-MM-DD).
NEXT_PUBLIC_RESEARCH_RETENTION_UNTIL=

# Produção: OpenAI
OPENAI_API_KEY=your_openai_api_key

# Desenvolvimento local apenas, se necessário. Não usar durante a coleta científica.
OPENROUTER_API_KEY=your_openrouter_api_key
