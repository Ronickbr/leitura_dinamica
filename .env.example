# Neon PostgreSQL (somente servidor; nunca use prefixo NEXT_PUBLIC_)
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Auth.js + Google OAuth (somente servidor)
AUTH_SECRET=gere_com_npx_auth_secret
AUTH_GOOGLE_ID=google_oauth_client_id
AUTH_GOOGLE_SECRET=google_oauth_client_secret
ADMIN_EMAIL=admin@example.com

# URL oficial da aplicação em produção
NEXT_PUBLIC_APP_URL=https://seu-dominio-oficial.example

# Pesquisa / governança de dados
# Defina antes da coleta conforme o protocolo aprovado (AAAA-MM-DD).
NEXT_PUBLIC_RESEARCH_RETENTION_UNTIL=
RESEARCH_RETENTION_UNTIL=

# Produção: OpenAI
OPENAI_API_KEY=your_openai_api_key
