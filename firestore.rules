rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(data) { return signedIn() && data.professorId == request.auth.uid; }
    function createsOwn() { return signedIn() && request.resource.data.professorId == request.auth.uid; }
    function keepsOwner() { return resource.data.professorId == request.resource.data.professorId; }
    function ownsStudent(studentId) {
      return signedIn()
        && get(/databases/$(database)/documents/alunos/$(studentId)).data.professorId == request.auth.uid;
    }

    match /alunos/{id} {
      allow read: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || createsOwn();
      allow update: if isAdmin() || (isOwner(resource.data) && keepsOwner());
      allow delete: if isAdmin();
    }

    match /student_private/{id} {
      allow read: if isAdmin() || ownsStudent(id);
      allow create: if isAdmin() || (ownsStudent(id) && createsOwn());
      allow update: if isAdmin() || (ownsStudent(id) && isOwner(resource.data) && keepsOwner());
      allow delete: if isAdmin();
    }

    match /avaliacoes/{id} {
      allow read: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || createsOwn();
      allow update: if isAdmin() || (isOwner(resource.data) && keepsOwner());
      allow delete: if isAdmin() || isOwner(resource.data);
    }

    match /import_history/{id} {
      allow read: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || createsOwn();
      allow update: if isAdmin() || (isOwner(resource.data) && keepsOwner());
      allow delete: if isAdmin();
    }

    match /textos/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /research_identity_map/{id} {
      allow read, write: if isAdmin();
    }

    match /data_subject_requests/{id} {
      allow create: if signedIn()
                    && request.resource.data.professorId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
